#!/usr/bin/env node
'use strict';
const fs = require('node:fs');
const { redact, parseJSON } = require('../src/security');
const { claudeEvent } = require('../src/claude');
const { codexEvent } = require('../src/codex');
const { copilotEvent } = require('../src/copilot');

async function main() {
  const [command, ...args] = process.argv.slice(2);
  if (!command || command === 'help') {
    console.log(`Murmurplex project mailbox\n\n    state\ninbox\nsend <recipient-id> <message...>\nack <message-id>\nstatus <working|idle|needs-input|needs-permission|finished>\ntask <title> [status] [owner-id] [task-id] [branch] [worktree-path] [task options]\ndecision <text...>\n\nCoordinator-only task planning options: --priority=low|normal|high|urgent; repeat --acceptance=TEXT and --depends-on=TASK_ID. Workers can update progress and blockers with --progress=TEXT and --blocker=TEXT. Clear acceptance/dependencies with --clear-acceptance or --clear-dependencies (coordinator only); clear progress/blocker with --clear-progress or --clear-blocker. Clear branch/worktree references with --clear-branch or --clear-worktree; set them with --branch=VALUE or --worktree=VALUE. Task dependencies must name existing tasks and cannot contain cycles.\nRun inside a Murmurplex terminal; messages are durable and require explicit acknowledgement.\nOnly the coordinator creates/assigns tasks and records decisions. Workers update their own assigned tasks using the existing task ID and cannot reassign them.\nTask references are optional; worktree paths may be absolute or relative to the project root.\nWorker state includes only messages they sent or received. Keep secrets out of messages, tasks and decisions.\nReading an inbox does not wake another agent or submit a prompt to its terminal.`);
    return;
  }
  const agentId = process.env.MURMURPLEX_AGENT_ID;
  const optionalArgument = value => value === '-' ? undefined : value;
  let endpoint, body;
  switch (command) {
    case 'claude-hook':
    case 'codex-hook':
    case 'copilot-hook': {
      const provider = { 'claude-hook': 'Claude', 'codex-hook': 'Codex', 'copilot-hook': 'Copilot' }[command];
      let payload = '';
      for await (const chunk of process.stdin) {
        payload += chunk;
        if (Buffer.byteLength(payload) > 1024 * 1024) throw new Error(`${provider} hook input exceeds 1 MiB.`);
      }
      if (!agentId) throw new Error(`${provider} hook requires MURMURPLEX_AGENT_ID.`);
      endpoint = `/hooks/${provider.toLowerCase()}`;
      body = { agentId, event: { 'claude-hook': claudeEvent, 'codex-hook': codexEvent, 'copilot-hook': copilotEvent }[command](parseJSON(payload, `${provider} hook input`)) };
      break;
    }
    case 'state': endpoint = '/state'; break;
    case 'inbox': endpoint = agentId ? `/inbox?agentId=${encodeURIComponent(agentId)}` : '/inbox'; break;
    case 'send': endpoint = '/messages'; body = { from: agentId, to: args[0], body: args.slice(1).join(' ') }; break;
    case 'ack': endpoint = '/ack'; body = { agentId, messageId: args[0] }; break;
    case 'status': endpoint = '/status'; body = { agentId, status: args[0] }; break;
    case 'task': {
      let branch = optionalArgument(args[4]);
      let worktreePath = optionalArgument(args[5]);
      const metadata = {};
      for (const option of args.slice(6)) {
        if (option === '--clear-branch') branch = null;
        else if (option === '--clear-worktree') worktreePath = null;
        else if (option.startsWith('--branch=')) branch = option.slice('--branch='.length);
        else if (option.startsWith('--worktree=')) worktreePath = option.slice('--worktree='.length);
        else if (option.startsWith('--priority=')) metadata.priority = option.slice('--priority='.length);
        else if (option.startsWith('--acceptance=')) (metadata.acceptanceCriteria ||= []).push(option.slice('--acceptance='.length));
        else if (option === '--clear-acceptance') metadata.acceptanceCriteria = [];
        else if (option.startsWith('--depends-on=')) (metadata.dependsOn ||= []).push(option.slice('--depends-on='.length));
        else if (option === '--clear-dependencies') metadata.dependsOn = [];
        else if (option.startsWith('--progress=')) metadata.progress = option.slice('--progress='.length);
        else if (option === '--clear-progress') metadata.progress = '';
        else if (option.startsWith('--blocker=')) metadata.blocker = option.slice('--blocker='.length);
        else if (option === '--clear-blocker') metadata.blocker = null;
        else throw new Error(`Unknown task option: ${option}`);
      }
      endpoint = '/tasks';
      body = {
        title: args[0], status: optionalArgument(args[1]), ownerId: optionalArgument(args[2]),
        id: optionalArgument(args[3]), branch, worktreePath, ...metadata
      };
      break;
    }
    case 'decision': endpoint = '/decisions'; body = { body: args.join(' ') }; break;
    default: throw new Error('Unknown command; use murmurplex-agent help.');
  }
  // The credential is read on every call so rotation and service restarts reach running terminals.
  const send = async () => {
    const credentials = process.env.MURMURPLEX_CREDENTIALS;
    if (!credentials) throw new Error('No Murmurplex credentials: run this inside a Murmurplex terminal.');
    const runtime = parseJSON(fs.readFileSync(credentials, 'utf8'), 'Credential file');
    return fetch(runtime.url + endpoint, {
      method: body ? 'POST' : 'GET', headers: { Authorization: `Bearer ${runtime.token}`, 'Content-Type': 'application/json' },
      ...(body ? { body: JSON.stringify(body) } : {}), signal: AbortSignal.timeout(5000)
    });
  };
  let response = await send();
  if (response.status === 401) response = await send();
  const value = parseJSON(await response.text(), 'Service response');
  if (!response.ok) throw new Error(value.error);
  if (!command.endsWith('-hook')) console.log(JSON.stringify(value, null, 2));
}
main().catch(error => {
  // Copilot denies tools when a PreToolUse command hook exits nonzero, and Codex
  // treats exit code 2 as a block or continuation. Status reporting must never do either.
  const provider = { 'copilot-hook': 'Copilot', 'codex-hook': 'Codex' }[process.argv[2]];
  const reportingOnly = Boolean(provider);
  console.error(`Murmurplex: ${reportingOnly ? `${provider} status reporting failed: ` : ''}${redact(error.message)}`);
  process.exitCode = reportingOnly ? 0 : 1;
});
